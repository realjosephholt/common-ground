# Copy to .env before `docker compose up`. Every value here is local to your Instance:
# there are no third-party API keys, because nothing an Instance does at runtime calls a
# third party.

POSTGRES_USER=common_ground
POSTGRES_PASSWORD=change-me
POSTGRES_DB=common_ground

# How often to archive Conversations that attracted no Votes. Default one hour.
SWEEP_INTERVAL_MS=3600000
